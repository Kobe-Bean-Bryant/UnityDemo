.container {
    padding: 12px;
}

.title {
    font-size: 20px;
    -unity-font-style: bold;
    margin-bottom: 4px;
}

.title-bar {
    height: 2px;
    background-color: rgb(187, 138, 58);
    margin-bottom: 16px;
    border-radius: 1px;
}

.section-card {
    background-color: rgba(0, 0, 0, 0.08);
    border-radius: 6px;
    border-width: 1px;
    border-color: rgba(128, 128, 128, 0.12);
    padding: 10px;
    margin-bottom: 10px;
}

.hint {
    font-size: 11px;
    opacity: 0.55;
    -unity-font-style: italic;
    margin-bottom: 8px;
}

.scan-button {
    height: 30px;
    -unity-font-style: bold;
    font-size: 13px;
    background-color: rgb(80, 140, 80);
    color: rgb(235, 235, 235);
    border-radius: 4px;
    border-width: 0;
}

.scan-button:hover {
    background-color: rgb(95, 160, 95);
}

.results-container {
    margin-bottom: 6px;
}

.result-row {
    flex-direction: row;
    align-items: center;
    padding: 6px 8px;
    margin: 2px 0;
    background-color: rgba(0, 0, 0, 0.06);
    border-radius: 4px;
}

.result-toggle {
    margin-right: 6px;
}

.result-path {
    flex-grow: 1;
    font-size: 12px;
    -unity-font-style: bold;
}

.result-info {
    font-size: 11px;
    opacity: 0.6;
    margin-left: 8px;
}

.restore-row {
    flex-direction: row;
    align-items: center;
    padding: 6px 8px;
    margin: 2px 0;
    background-color: rgba(220, 80, 80, 0.08);
    border-radius: 4px;
}

.restore-label {
    font-size: 12px;
    color: rgb(220, 120, 80);
}

.create-button {
    height: 36px;
    margin-top: 14px;
    -unity-font-style: bold;
    font-size: 14px;
    background-color: rgb(50, 110, 175);
    color: rgb(235, 235, 235);
    border-radius: 6px;
    border-width: 0;
}

.create-button:hover {
    background-color: rgb(65, 128, 198);
}

.create-button:active {
    background-color: rgb(38, 90, 148);
}

.status-label {
    margin-top: 8px;
    padding: 6px;
    -unity-text-align: middle-center;
    border-radius: 4px;
    min-height: 20px;
}

.status-success {
    color: rgb(86, 196, 86);
    background-color: rgba(86, 196, 86, 0.07);
}

.status-error {
    color: rgb(220, 80, 80);
    background-color: rgba(220, 80, 80, 0.07);
}
