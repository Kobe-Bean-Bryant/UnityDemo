/* ===== 根容器 ===== */
.container {
    padding: 12px;
}

/* ===== 标题 ===== */
.title {
    font-size: 20px;
    -unity-font-style: bold;
    margin-bottom: 4px;
}

/* 标题下方的彩色强调线 */
.title-bar {
    height: 2px;
    background-color: rgb(58, 121, 187);
    margin-bottom: 16px;
    border-radius: 1px;
}

/* ===== 卡片式分区容器 ===== */
.section-card {
    background-color: rgba(0, 0, 0, 0.08);
    border-radius: 6px;
    border-width: 1px;
    border-color: rgba(128, 128, 128, 0.12);
    padding: 10px;
    margin-bottom: 10px;
}

/* ===== 路径 / 命名空间预览 ===== */
.preview-row {
    flex-direction: row;
    align-items: center;
    margin-top: 4px;
}

.preview-key {
    width: 84px;
    opacity: 0.55;
    -unity-font-style: italic;
    font-size: 11px;
}

.preview-value {
    color: rgb(86, 182, 86);
    -unity-font-style: bold;
    font-size: 12px;
}

/* ===== Foldout 分区 ===== */
.section-foldout {
    margin-bottom: 6px;
}

.sub-foldout {
    margin-left: 12px;
    margin-top: 2px;
    margin-bottom: 2px;
}

/* ===== 资源文件夹 Toggle 网格 ===== */
.toggles-grid {
    flex-direction: row;
    flex-wrap: wrap;
    padding: 4px 0;
}

.folder-toggle {
    width: 48%;
    margin: 3px 1%;
}

/* ===== ASMDEF Toggle ===== */
.asmdef-toggle {
    margin: 2px 0;
}

/* ===== Resources 提示 ===== */
.hint {
    font-size: 10px;
    opacity: 0.45;
    margin-left: 20px;
    margin-top: 2px;
    -unity-font-style: italic;
}

/* ===== 渲染模式选择 ===== */
.section-label {
    font-size: 12px;
    -unity-font-style: bold;
    margin-bottom: 6px;
}

.rendering-mode-group {
    margin-left: 8px;
    margin-bottom: 4px;
}

.rendering-mode-group > .unity-radio-button {
    margin: 3px 0;
}

/* ===== 分隔线 ===== */
.separator {
    height: 1px;
    background-color: rgba(128, 128, 128, 0.18);
    margin: 10px 0;
}

/* ===== 创建按钮 ===== */
.create-button {
    height: 36px;
    margin-top: 14px;
    -unity-font-style: bold;
    font-size: 14px;
    background-color: rgb(50, 110, 175);
    color: rgb(235, 235, 235);
    border-radius: 6px;
    border-width: 0;
}

.create-button:hover {
    background-color: rgb(65, 128, 198);
}

.create-button:active {
    background-color: rgb(38, 90, 148);
}

/* ===== 状态标签 ===== */
.status-label {
    margin-top: 8px;
    padding: 6px;
    -unity-text-align: middle-center;
    border-radius: 4px;
    min-height: 20px;
}

.status-success {
    color: rgb(86, 196, 86);
    background-color: rgba(86, 196, 86, 0.07);
}

.status-error {
    color: rgb(220, 80, 80);
    background-color: rgba(220, 80, 80, 0.07);
}
